# Kullo environment template.
# Local dev: copy to .env.local (loaded first, wins over .env).
# Supabase/Vercel values: fill .env or the Vercel dashboard.

# PostgreSQL connection string. Locally: any Postgres instance (or Docker).
# Production: Supabase → Connect → Transaction pooler (port 6543).
# The password must be URL-encoded: "#" → %23, "@" → %40, "/" → %2F.
# An unescaped "#" truncates the URL and the host silently becomes the user.
DATABASE_URL=

# Direct/session connection used only for migrations and seeding.
# Supabase → Connect → Direct connection (or Session pooler, port 5432).
# Falls back to DATABASE_URL when unset. Same encoding rules apply.
DIRECT_URL=

# Set to "false" only for a local Postgres without TLS.
DATABASE_SSL=

# Supabase Storage (production file uploads). Leave empty locally to use
# data/uploads. Create a private bucket, e.g. kullo-files.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=kullo-files

# Set automatically by Next.js (production | development). Not set by hand.
# NODE_ENV=

# Tampilkan akun demo di halaman masuk. Default: aktif di development,
# nonaktif di production. Set 1 untuk demo publik.
KULLO_SHOW_DEMO=
