# Kullo environment template — copy to .env for local runs.
# Every value below has a working default; nothing is required to start.

# Absolute path to the SQLite database file.
# Default: <repo>/data/kullo.db (created by `npm run db:setup`)
DATABASE_PATH=

# Set automatically by Next.js (production | development). Not set by hand.
# NODE_ENV=

# Tampilkan akun demo di halaman masuk. Default: aktif di development,
# nonaktif di production. Set 1 untuk demo publik.
KULLO_SHOW_DEMO=
